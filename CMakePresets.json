{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 15,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "BUILD_DESKTOP": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-vs2022-debug",
      "displayName": "Windows VS2022 Debug",
      "description": "Visual Studio 2022 Debug 配置",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/build/vs2022_debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-vs2022-release",
      "displayName": "Windows VS2022 Release",
      "description": "Visual Studio 2022 Release 配置",
      "inherits": "windows-base",
      "binaryDir": "${sourceDir}/build/vs2022_release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-vs2019-debug",
      "displayName": "Windows VS2019 Debug",
      "description": "Visual Studio 2019 Debug 配置",
      "inherits": "windows-base",
      "generator": "Visual Studio 16 2019",
      "binaryDir": "${sourceDir}/build/vs2019_debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-vs2019-release",
      "displayName": "Windows VS2019 Release",
      "description": "Visual Studio 2019 Release 配置",
      "inherits": "windows-base",
      "generator": "Visual Studio 16 2019",
      "binaryDir": "${sourceDir}/build/vs2019_release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-vs2022-debug",
      "displayName": "构建 Windows VS2022 Debug",
      "configurePreset": "windows-vs2022-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-vs2022-release",
      "displayName": "构建 Windows VS2022 Release",
      "configurePreset": "windows-vs2022-release",
      "configuration": "Release"
    },
    {
      "name": "windows-vs2019-debug",
      "displayName": "构建 Windows VS2019 Debug",
      "configurePreset": "windows-vs2019-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-vs2019-release",
      "displayName": "构建 Windows VS2019 Release",
      "configurePreset": "windows-vs2019-release",
      "configuration": "Release"
    }
  ]
}
